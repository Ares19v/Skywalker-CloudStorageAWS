# CompanyDB — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# ── PostgreSQL (AWS RDS) ──────────────────────────────────────────
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=postgres
DB_PASSWORD=your_db_password

# ── AWS S3 (file storage) ─────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_iam_access_key_id
AWS_SECRET_ACCESS_KEY=your_iam_secret_access_key
S3_BUCKET_NAME=your-s3-bucket-name
S3_PUBLIC_URL=https://your-bucket.s3.ap-south-1.amazonaws.com

# ── Server ────────────────────────────────────────────────────────
PORT=3000

# ── Sessions (use a long random string) ──────────────────────────
SESSION_SECRET=replace_this_with_a_very_long_random_string

# ── File Uploads ──────────────────────────────────────────────────
MAX_FILE_SIZE_MB=100

# ── Admin Lock ───────────────────────────────────────────────────
# Set to "true" to restrict ALL deletions to admins only
ADMIN_LOCK=false

# ── Storage meter (free tier GB — S3=5, Cloudflare R2=10) ────────
S3_FREE_GB=5
