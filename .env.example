# Skywalker — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# ── PostgreSQL (AWS RDS or local) ────────────────────────────────
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=skywalker
DB_USER=postgres
DB_PASSWORD=your_db_password
# Set to "false" for local Docker dev (no SSL). Leave unset for AWS RDS (SSL on).
DB_SSL=true

# ── AWS S3 (file storage) ─────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_iam_access_key_id
AWS_SECRET_ACCESS_KEY=your_iam_secret_access_key
S3_BUCKET_NAME=your-s3-bucket-name
S3_PUBLIC_URL=https://your-bucket.s3.ap-south-1.amazonaws.com

# ── S3-Compatible Storage (optional — for Cloudflare R2 or LocalStack) ──
# S3_ENDPOINT=http://localhost:4566
# S3_FREE_GB=10

# ── Server ────────────────────────────────────────────────────────
PORT=3000

# ── Sessions (MUST be a long, random secret string — 32+ chars) ──
SESSION_SECRET=replace_this_with_a_very_long_random_string_minimum_32_chars

# ── File Uploads ──────────────────────────────────────────────────
# Maximum file size in megabytes
MAX_FILE_SIZE_MB=100

# ── Admin Lock ────────────────────────────────────────────────────
# Set to "true" to restrict ALL entry deletions to admins only
ADMIN_LOCK=false

# ── Storage Meter ─────────────────────────────────────────────────
# Free tier GB displayed in the health dashboard
# AWS S3 free tier = 5, Cloudflare R2 free tier = 10
S3_FREE_GB=5
