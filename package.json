{
  "name": "skywalker",
  "version": "1.0.0",
  "description": "Role-based cloud storage service and vault dashboard with Node.js, PostgreSQL, and AWS S3 integration.",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node scripts/initDb.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down -v"
  },
  "keywords": [
    "dashboard",
    "aws",
    "s3",
    "postgresql",
    "express",
    "nodejs",
    "file-vault",
    "role-based-access"
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1034.0",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-session": "^1.18.0",
    "helmet": "^7.2.0",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "pg": "^8.11.5",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}