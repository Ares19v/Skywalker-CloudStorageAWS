# ── Dependencies (always re-installed inside image) ──────────────────────────
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Environment / Secrets ─────────────────────────────────────────────────────
.env
*.pem
*.key
*.p12
*.pfx

# ── Git & CI ──────────────────────────────────────────────────────────────────
.git
.gitignore
.github

# ── Local uploads (files are in S3, not the container) ───────────────────────
uploads/

# ── Local dev artifacts ───────────────────────────────────────────────────────
companydb_backup.sql
*.bak

# ── Editor / OS noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Documentation (not needed at runtime) ────────────────────────────────────
*.md
LICENSE

# ── Windows launchers ─────────────────────────────────────────────────────────
*.bat
*.sh
*.lnk
